# Copiá este archivo como `.env` (sin la palabra example) y cambiá solo lo que necesites.
# Con los valores por defecto la app usa Ollama en tu computadora: no hace falta crear nada.

# Proveedor del modelo: ollama (gratis, local; por defecto) | gemini | claude
LLM_PROVIDER=ollama

# Modelos (si los dejás vacíos se usan los de por defecto de cada proveedor)
# LLM_MODELO_PRINCIPAL=qwen2.5:3b
# LLM_MODELO_LIVIANO=qwen2.5:3b
# EMBEDDINGS_MODELO=bge-m3          # alternativa más liviana: nomic-embed-text
# EMBEDDINGS_PROVIDER=ollama        # ollama | gemini (Claude no ofrece embeddings)

# Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=4096               # no lo subas con 8 GB de memoria
# LLM_TIMEOUT_S=900                 # segundos máximos de espera por respuesta

# Cuántos puestos se recuperan y cuántos se puntúan por búsqueda
# RECUPERAR_K=10
# PUNTUAR_N=5

# Claves de API: SOLO si elegís gemini o claude. Nunca las subas a un repositorio.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
